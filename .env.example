# =============================================================================
# IVOIRCUISSON — Configuration de l'application
# =============================================================================
# Boutique en ligne (Laravel 13 + Inertia/React), multi-boutiques par team.
# Copier ce fichier en `.env` puis lancer `php artisan key:generate`.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8086
APP_PORT=8086
VITE_PORT=5177

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# -----------------------------------------------------------------------------
# Sécurité & Chiffrement
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Base de données
# -----------------------------------------------------------------------------
# DB_HOST=mysql → nom du service Docker. Depuis l'host (TablePlus, DBeaver…) :
# 127.0.0.1:3310 avec les mêmes identifiants.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cuisson
DB_USERNAME=sail
DB_PASSWORD=password

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -----------------------------------------------------------------------------
# File system & Queue
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Conteneur disponible mais non utilisé par défaut : cache, sessions et queue
# passent par la base. Basculer CACHE_STORE/SESSION_DRIVER/QUEUE_CONNECTION
# sur "redis" suffit à l'activer.
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Sail (Docker)
# -----------------------------------------------------------------------------
# Plage de ports réservée à Ivoir. Les autres projets du poste occupent déjà :
#   dymora 8000/5173/3306 · dym_location 8080/5173/3306/6379/8081
#   lokea 8082/5174/3307/6380 · appel_fonds 8083/5176/3309/6382/8093
#   vilora 8084/5178/3311/6383/8085 · grh_v1 8090/5175/3308/6381/8091
# Détail et procédure : docker/README.md
# -----------------------------------------------------------------------------
WWWUSER=1000
WWWGROUP=1000

FORWARD_DB_PORT=3310
FORWARD_REDIS_PORT=6384
FORWARD_PHPMYADMIN_PORT=8087

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# En local : "log" écrit les mails dans storage/logs/laravel.log au lieu de les
# envoyer.
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Où arrivent les alertes internes : nouvelles commandes, messages de contact.
SHOP_NOTIFICATION_EMAIL="ivoircuisson@dym.ci"

# -----------------------------------------------------------------------------
# AWS S3 (non configuré)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Vite (frontend)
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
